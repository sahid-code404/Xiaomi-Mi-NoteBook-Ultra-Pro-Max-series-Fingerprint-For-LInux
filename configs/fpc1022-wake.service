[Unit]
Description=Xiaomi FPC1022 Power Button Hardware Initialization
Documentation=https://github.com/sahid-code404/Xiaomi-Notebook-Ultra-Max-Series-Fingerprint-For-Linux
DefaultDependencies=no
After=systemd-udevd.service
Before=basic.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fpc1022-wake
RemainAfterExit=yes

[Install]
WantedBy=basic.target
