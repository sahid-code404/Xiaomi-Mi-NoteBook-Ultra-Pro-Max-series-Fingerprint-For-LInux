// Optional, system-wide PolicyKit hardening for fprintd.
// When explicitly installed, requires administrator authorization for enrollment
// and username changes. This affects all fprintd-compatible sensors, not only Xiaomi.

polkit.addRule(function(action, subject) {
    if (action.id == "net.reactivated.fprint.device.enroll" ||
        action.id == "net.reactivated.fprint.device.setusername") {
        return polkit.Result.AUTH_ADMIN;
    }
});
